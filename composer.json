{
    "name": "eossa/saloon-legacy",
    "description": "Build beautiful API integrations and SDKs with Saloon",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "sammyjo20",
        "saloon",
        "sdk",
        "api",
        "api-integrations"
    ],
    "authors": [
        {
            "name": "Sam Carré",
            "email": "29132017+Sammyjo20@users.noreply.github.com",
            "role": "Developer"
        },
        {
            "name": "Elkin Ossa",
            "email": "16960004+eossa@users.noreply.github.com",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/eossa/saloon",
    "require": {
        "php": "^5.6 || ~7.0",
        "guzzlehttp/guzzle": "^6.3",
        "guzzlehttp/promises": "^1.3",
        "guzzlehttp/psr7": "^1.6",
        "psr/http-message": "^1.0",
        "ext-json": "*"
    },
    "require-dev": {
        "ext-simplexml": "*",
        "friendsofphp/php-cs-fixer": "^2.0",
        "league/flysystem": "^1.0",
        "phpunit/phpunit": "^5.7",
        "symfony/dom-crawler": "^3.0",
        "symfony/var-dumper": "^3.0"
    },
    "conflict": {
        "sammyjo20/saloon": "*"
    },
    "suggest": {
        "illuminate/support": "Required for the response collect() method.",
        "symfony/dom-crawler": "Required for the response dom() method.",
        "symfony/var-dumper": "Required for default debugging drivers."
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Saloon\\": "src/",
            "GuzzleHttp\\": "libs/guzzle/",
            "Psr\\": "libs/psr/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Saloon\\Tests\\": "tests/"
        },
        "files": [
            "tests/helpers.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "fix-code": [
            "./vendor/bin/php-cs-fixer fix --allow-risky=yes"
        ]
    }
}
